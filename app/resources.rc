#include <windows.h>
101 ICON "../assets/icon.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 1,2,1,0
PRODUCTVERSION 1,2,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Cursor-targeted monitor brightness"
      VALUE "FileVersion", "1.2.1"
      VALUE "InternalName", "CursorBrightness"
      VALUE "OriginalFilename", "CursorBrightness.exe"
      VALUE "ProductName", "Cursor Brightness"
      VALUE "ProductVersion", "1.2.1"
      VALUE "LegalCopyright", "GPL-3.0-only; see LICENSE and THIRD_PARTY_NOTICES.md"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
